# 云环境示例配置
DEBUG=False
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

DEFAULT_TTS_MODEL=cosyvoice2

# 模型目录建议挂载到持久卷
COSYVOICE_MODEL_DIR=/opt/tts-api/models/CosyVoice2-0.5B
QWEN3_MODEL_DIR=/opt/tts-api/models/Qwen3-TTS-12Hz-1.7B-Base

MFA_ACOUSTIC_MODEL=mandarin_mfa
MFA_DICTIONARY=mandarin_mfa
MFA_ENABLE=True
MFA_TIMEOUT=120

TEMP_AUDIO_DIR=/opt/tts-api/temp_audio
OUTPUT_AUDIO_DIR=/opt/tts-api/output_audio
LOG_DIR=/opt/tts-api/logs

MAX_WORKERS=4
MAX_FILE_SIZE_MB=100
ENABLE_UPLOAD_ENDPOINT=True
AUDIO_OUTPUT_FORMAT=both

# 如需网关鉴权，请在反向代理或应用层自行接入
# API_KEY=replace-me
