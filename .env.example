# 应用配置
DEBUG=False
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=False

# 默认模型
DEFAULT_TTS_MODEL=cosyvoice2
# install.sh 会按这个值只下载一个模型

# 模型路径
COSYVOICE_MODEL_DIR=./models/CosyVoice2-0.5B
QWEN3_MODEL_DIR=./models/Qwen3-TTS-12Hz-1.7B-Base

# Qwen3 推理参数
QWEN3_DTYPE=bfloat16
QWEN3_ATTN_IMPL=flash_attention_2

# MFA 配置
MFA_ACOUSTIC_MODEL=mandarin_mfa
MFA_DICTIONARY=mandarin_mfa
MFA_ENABLE=True
# 设为 False 时安装脚本会跳过 MFA
MFA_TIMEOUT=120
MFA_FALLBACK_ALIGNMENT=none

# 文件目录
TEMP_AUDIO_DIR=./temp_audio
OUTPUT_AUDIO_DIR=./output_audio
LOG_DIR=./logs

# 接口行为
MAX_WORKERS=4
MAX_FILE_SIZE_MB=50
ENABLE_UPLOAD_ENDPOINT=True
AUDIO_OUTPUT_FORMAT=base64
