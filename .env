# 应用配置
APP_NAME=YuHuo TTS
APP_VERSION=0.1.0
DEBUG=False

# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=4

# 日志配置
LOG_LEVEL=INFO

# 音频处理配置
SAMPLE_RATE=22050
MAX_AUDIO_DURATION=300
TEMP_AUDIO_DIR=./temp_audio
OUTPUT_AUDIO_DIR=./output_audio

# 模型配置
MODEL_DIR=./models
ALIGNMENT_MODEL_DIR=./alignment

# 数据库配置 (如果需要)
DATABASE_URL=sqlite:///./yuhuo_tts.db

# MFA (Montreal Forced Aligner) 配置
MFA_ALIGN_MODEL=
MFA_ALIGN_MODEL_PATH=./alignment/models
